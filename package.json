{
  "name": "battleship",
  "private": true,
  "version": "0.7.0",
  "description": "A lightweight 3D WWII naval combat game with single-player battles, two-player LAN co-op, modular damage and AI-controlled fleet aviation.",
  "author": {
    "name": "Arsenic-er",
    "email": "302726993@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arsenic-er/Game-Super-Boring-Battleship.git"
  },
  "homepage": "https://github.com/Arsenic-er/Game-Super-Boring-Battleship",
  "bugs": {
    "url": "https://github.com/Arsenic-er/Game-Super-Boring-Battleship/issues"
  },
  "keywords": [
    "wwii",
    "naval-combat",
    "battleship",
    "babylonjs",
    "electron",
    "single-player",
    "lan-coop",
    "multiplayer"
  ],
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "balance": "vitest run tests/balanceReport.test.ts --reporter=verbose",
    "balance:matrix": "vitest run tests/balanceMatrixReport.test.ts --reporter=verbose",
    "assets:ships:validate": "node scripts/validate-ship-assets.ts",
    "test": "vitest run",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win --x64 --dir",
    "desktop:zip": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@babylonjs/core": "9.16.1",
    "@babylonjs/loaders": "^9.16.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "io.greysea.battleship",
    "productName": "Super Boring Battleship Game",
    "artifactName": "battleship-${version}-windows-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/assets/ships/**/*",
      "dist/assets/textures/**/*",
      "dist/assets/equipment/**/*",
      "dist/assets/cursors/**/*",
      "dist/assets/audio/**/*"
    ]
  }
}
