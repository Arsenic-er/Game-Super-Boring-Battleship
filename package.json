{
  "name": "battleship",
  "private": true,
  "version": "0.6.12",
  "description": "A lightweight single-player 3D WWII naval combat game with modular damage and AI-controlled fleet aviation.",
  "author": {
    "name": "Arsenic-er",
    "email": "302726993@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arsenic-er/Game-Super-Boring-Battleship.git"
  },
  "homepage": "https://github.com/Arsenic-er/Game-Super-Boring-Battleship",
  "bugs": {
    "url": "https://github.com/Arsenic-er/Game-Super-Boring-Battleship/issues"
  },
  "keywords": ["wwii", "naval-combat", "battleship", "babylonjs", "electron", "single-player"],
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "balance": "vitest run tests/balanceReport.test.ts --reporter=verbose",
    "balance:matrix": "vitest run tests/balanceMatrixReport.test.ts --reporter=verbose",
    "assets:ships:validate": "node scripts/validate-ship-assets.ts",
    "test": "vitest run",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@babylonjs/core": "9.16.1"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "io.greysea.battleship",
    "productName": "Super Boring Battleship Game",
    "artifactName": "battleship-${version}-windows-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
